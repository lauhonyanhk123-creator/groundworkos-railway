# =============================================================================
# GroundworkOS — environment variables
# =============================================================================
# This file documents every environment variable the app uses. Copy the values
# you need into your own environment (Railway service Variables, a systemd
# EnvironmentFile, a shell export, or a .env file) — do NOT commit real secrets.
#
# There are three different ways to run GroundworkOS:
#
# * On Railway (recommended) — a single service builds and runs both the API
#   server and the frontend. See RAILWAY.md for the full walkthrough. You
#   provide your own Postgres (Railway plugin), Clerk account, and
#   S3-compatible object storage (Railway has no built-in object storage).
#
# * Self-hosted (e.g. a VPS) — you provide your own database, your own
#   S3-compatible object storage, and your own Clerk account.
#   See the in-app Deploy Guide (/deploy, admin only) for an Oracle Cloud +
#   Nginx + PM2 walkthrough.
#
# Each variable below is tagged:
#   [core]     needed everywhere
#   [railway]  needed (or notably relevant) when deploying on Railway
#   [selfhost] set these when self-hosting off Replit
#   [optional] only if you use that feature
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------

# [core] Port the API server listens on. On Railway this is provided
# automatically at both build and run time — do not set it yourself. On a
# self-hosted VM, 8080 is fine (Nginx proxies to it). Also required when
# BUILDING the frontend (any value).
PORT=8080

# [core] Node environment. Use "production" when self-hosting or on Railway.
NODE_ENV=production

# [optional] Log verbosity: trace|debug|info|warn|error. Defaults to info.
# LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database (PostgreSQL) — [core]
# -----------------------------------------------------------------------------
# Standard Postgres connection string. On Replit this is provided for you.
# On Railway, add a PostgreSQL plugin to the project and reference its
# variable instead of retyping it, e.g. ${{Postgres.DATABASE_URL}}.
# Self-hosting example (local Postgres on the same VM):
DATABASE_URL=postgresql://groundworkos:CHANGE_ME@localhost:5432/groundworkos

# -----------------------------------------------------------------------------
# Authentication (Clerk)
# -----------------------------------------------------------------------------
# Backend keys (from your Clerk dashboard → API Keys).
CLERK_PUBLISHABLE_KEY=pk_test_xxx_or_pk_live_xxx  # [core]
CLERK_SECRET_KEY=sk_test_xxx_or_sk_live_xxx        # [core]

# [railway] [selfhost] Set to "true" whenever running off Replit against your
# own Clerk account — this includes Railway. This turns OFF the Replit Clerk
# proxy and makes the app use the keys above directly. Leave UNSET (or
# "false") on Replit.
CLERK_STANDALONE=true

# [railway] [selfhost] Public URL of your deployed app, e.g.
# https://your-app.up.railway.app or https://app.yourdomain.com. Used for
# Clerk's authorizedParties check and for client-portal links.
# APP_URL=https://your-app.up.railway.app

# --- Restricting sign-up to invited users only ---
# GroundworkOS is meant to run as a single-company instance, not a
# public multi-tenant sign-up product. The primary control for this is a
# Clerk Dashboard setting, not an env var: go to Clerk Dashboard ->
# Configure -> Restrictions, and set "Sign-up mode" to "Restricted". That
# stops Clerk itself from creating an account for anyone who wasn't invited
# (Users -> Invite in the dashboard, or Settings -> Users -> Invite in the
# app once you're signed in as an admin). The two variables below are an
# OPTIONAL server-side backstop on top of that, not a replacement for it.

# [optional] Signing secret for a Clerk webhook endpoint pointed at
# <APP_URL>/api/webhooks/clerk (Clerk Dashboard -> Webhooks -> Add Endpoint,
# subscribed to the "user.created" event -> copy its Signing Secret here).
# Required only if you also set SIGNUP_ALLOWED_EMAIL_DOMAINS below.
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# [optional] Comma-separated email domains allowed to sign up, e.g.
# "yourcompany.co.uk". Enforced server-side, after the fact, against any
# account Clerk did create - a backstop for if Restrictions above is ever
# left open or misconfigured. Accounts created through the in-app invite
# flow are always allowed regardless of domain. Leave unset to disable this
# check entirely and rely on Clerk Dashboard Restrictions alone.
# SIGNUP_ALLOWED_EMAIL_DOMAINS=yourcompany.co.uk

# --- Frontend (build-time) Clerk vars ---
# These are baked into the frontend at BUILD time (they must be present when you
# run the frontend build; they are NOT read at runtime).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx_or_pk_live_xxx  # [core]



# [core] Base path the frontend is served under. Required at build time —
# the frontend's Vite config throws if this is unset, so Railway builds will
# fail without it. Use "/" when the app is served at the domain root (the
# normal Railway and self-host case).
BASE_PATH=/

# [railway] Tells the API server to serve the built frontend itself, so a
# single Railway service can host both the API and the SPA with no separate
# static host or reverse proxy. Must match the frontend build's output dir.
# STATIC_DIR=artifacts/groundworkos/dist/public

# -----------------------------------------------------------------------------
# Object storage — [core]
# -----------------------------------------------------------------------------
# S3-compatible object storage (Railway, Oracle Object Storage, AWS S3,
# Cloudflare R2, Backblaze B2, MinIO). Railway does not provide object
# storage itself, so these MUST be set on Railway — uploads will fail
# without them.

# For Oracle Cloud Object Storage, the endpoint looks like:
# https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
S3_ENDPOINT=https://NAMESPACE.compat.objectstorage.uk-london-1.oraclecloud.com
S3_REGION=uk-london-1
S3_BUCKET=groundworkos-files
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
# Oracle requires path-style addressing; most other providers do too. Leave
# "true" unless your provider needs virtual-hosted-style (then set "false").
S3_FORCE_PATH_STYLE=true
# Key prefix under which public assets are stored (optional). Default: public/
# S3_PUBLIC_PREFIX=public/

# -----------------------------------------------------------------------------
# Email (Resend) — [optional]
# -----------------------------------------------------------------------------
# Only needed if you send emails (e.g. invoices) from the app.
# RESEND_API_KEY=re_xxx

# -----------------------------------------------------------------------------
# Accounting integrations — [optional]
# -----------------------------------------------------------------------------
# Only set the provider(s) you actually connect. Each REDIRECT_URI must point at
# YOUR deployed domain (e.g. https://your-app.up.railway.app/api/xero/callback
# on Railway), and must be registered in that provider's developer dashboard.

# Xero
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# XERO_REDIRECT_URI=https://app.yourdomain.com/api/xero/callback

# QuickBooks
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_REDIRECT_URI=https://app.yourdomain.com/api/quickbooks/callback

# Sage
# SAGE_CLIENT_ID=
# SAGE_CLIENT_SECRET=
# SAGE_REDIRECT_URI=https://app.yourdomain.com/api/sage/callback

# FreeAgent
# FREEAGENT_CLIENT_ID=
# FREEAGENT_CLIENT_SECRET=
# FREEAGENT_REDIRECT_URI=https://app.yourdomain.com/api/freeagent/callback
